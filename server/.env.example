# Server (Node.js + Express) environment variables
# Copy to .env and fill in real values locally. Never commit .env.

# HTTP server
PORT=5000
NODE_ENV=development

# Allowed CORS origin (frontend URL)
CLIENT_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string.
# Examples:
#   Atlas SRV:  mongodb+srv://USER:PASS@cluster0.abcd.mongodb.net/wehelpus?retryWrites=true&w=majority
#   Atlas direct (recommended when Node DNS SRV fails):
#               mongodb://USER:PASS@shard-00-00.abcd.mongodb.net:27017,shard-00-01.abcd.mongodb.net:27017,shard-00-02.abcd.mongodb.net:27017/wehelpus?ssl=true&authSource=admin&retryWrites=true&w=majority
#   Local:      mongodb://127.0.0.1:27017/wehelpus
# In production, MONGODB_URI is REQUIRED — the server exits if it's missing or unreachable.
# In development, the server boots without a DB (health route reports db.connected=false).
#
# If you see `querySrv ECONNREFUSED _mongodb._tcp.<cluster>.mongodb.net`,
# Node 24 on Windows is failing the SRV lookup. Switch to the direct-URI
# form above (you'll find both forms in the Atlas "Connect → Drivers" dialog).
# Also make sure your IP is whitelisted: Atlas → Network Access.
MONGODB_URI=

# Optional: Mongoose tunables (defaults shown)
# DB_SERVER_SELECTION_TIMEOUT_MS=10000
# DB_CONNECT_TIMEOUT_MS=10000
# DB_MAX_RETRIES=5      # dev-only retry budget; ignored in production

# JWT
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
